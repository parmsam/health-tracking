---
// Trend over time, single series → line chart. Single series needs no legend
// (the title names it); direct end-label carries the current value; native
// <title> tooltips on each point are the lightweight hover layer.
interface Props {
  points: { date: Date; weight_lb: number }[];
}

const { points } = Astro.props;

const width = 600;
const height = 160;
const padding = { top: 14, right: 12, bottom: 22, left: 12 };
const plotW = width - padding.left - padding.right;
const plotH = height - padding.top - padding.bottom;

const values = points.map(p => p.weight_lb);
const min = values.length ? Math.min(...values) : 0;
const max = values.length ? Math.max(...values) : 0;
const range = max - min || 1;

const xFor = (i: number) =>
  points.length > 1 ? padding.left + (i / (points.length - 1)) * plotW : padding.left + plotW / 2;
const yFor = (v: number) => padding.top + plotH - ((v - min) / range) * plotH;

const coords = points.map((p, i) => ({ x: xFor(i), y: yFor(p.weight_lb), date: p.date, weight_lb: p.weight_lb }));
const pathD = coords.map((c, i) => `${i === 0 ? 'M' : 'L'} ${c.x.toFixed(1)} ${c.y.toFixed(1)}`).join(' ');

const dateFmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
const last = coords[coords.length - 1];
---

<div class="viz-root">
  <p class="text-sm text-[var(--text-secondary)] mb-2">Weight trend</p>
  {points.length === 0 && <p class="text-sm text-[var(--text-muted)]">No check-ins logged yet.</p>}
  {points.length === 1 && (
    <p class="text-2xl font-semibold text-[var(--text-primary)]">{points[0].weight_lb} lb</p>
  )}
  {points.length > 1 && (
    <svg viewBox={`0 0 ${width} ${height}`} class="w-full h-auto" role="img" aria-label="Weight trend over time">
      <line
        x1={padding.left}
        y1={padding.top + plotH}
        x2={width - padding.right}
        y2={padding.top + plotH}
        stroke="var(--baseline)"
        stroke-width="1"
      />
      <path d={pathD} fill="none" stroke="var(--meter-fill)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      {coords.slice(0, -1).map(c => (
        <circle cx={c.x} cy={c.y} r="3" fill="var(--meter-fill)" opacity="0.5">
          <title>{`${dateFmt(c.date)}: ${c.weight_lb} lb`}</title>
        </circle>
      ))}
      <circle cx={last.x} cy={last.y} r="5" fill="var(--meter-fill)" stroke="var(--surface-1)" stroke-width="2">
        <title>{`${dateFmt(last.date)}: ${last.weight_lb} lb`}</title>
      </circle>
      <text x={last.x} y={last.y - 12} text-anchor="end" font-size="12" fill="var(--text-primary)">{last.weight_lb} lb</text>
      <text x={padding.left} y={height - 6} font-size="10" fill="var(--text-muted)">{dateFmt(points[0].date)}</text>
      <text x={width - padding.right} y={height - 6} text-anchor="end" font-size="10" fill="var(--text-muted)">
        {dateFmt(points[points.length - 1].date)}
      </text>
    </svg>
  )}
</div>
