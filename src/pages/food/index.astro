---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FoodDayCard from '../../components/FoodDayCard.astro';
import TagPill from '../../components/TagPill.astro';
import { sortByDateDesc, flattenByDate, allTags } from '../../lib/aggregate';
import { withBase } from '../../lib/url';

const days = sortByDateDesc(await getCollection('food'));
const tags = allTags([flattenByDate(days)]);
---

<Base title="Food">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-stone-900 dark:text-stone-100 mb-1">Food</h1>
    <p class="text-stone-400 text-sm">Daily food log, most recent first.</p>
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mb-8">
      {tags.map(tag => <TagPill tag={tag} href={withBase(`tags/${tag}`)} />)}
    </div>
  )}

  {days.length === 0 ? (
    <p class="text-sm text-stone-400 dark:text-stone-500">
      No food logged yet. Try
      <code class="px-1 py-0.5 rounded bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300">/log-food</code>
      in Claude Code.
    </p>
  ) : (
    days.map(day => <FoodDayCard day={day} />)
  )}
</Base>
